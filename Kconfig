config ZMK_INPUT_PROCESSOR_GESTURE_NAV
    bool "Gesture navigation input processor (pointer swipe -> behaviors)"
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_GESTURE_NAV_ENABLED
    # ビヘイビアのキュー(behavior_queue.c)は親機でしかビルドされない。
